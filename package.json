{
  "name": "@xtrm-dev/mcp-inspector-x",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "bin": {
    "mcp-inspector-x": "./bin/mcp-inspector-x.mjs"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "npm run dev --workspace @mcp-inspector-x/web",
    "dev:gateway": "npm run dev --workspace @mcp-inspector-x/gateway",
    "dev:runner": "npm run dev --workspace @mcp-inspector-x/runner",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest",
    "package": "node scripts/package.mjs",
    "smoke": "node scripts/smoke.mjs",
    "smoke:collapse": "node scripts/smoke-collapse-visible.mjs",
    "conformance": "node scripts/conformance.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.2",
    "vitest": "^4.0.0"
  }
}
