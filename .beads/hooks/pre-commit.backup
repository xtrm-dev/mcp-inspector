#!/usr/bin/env bash
# Pre-commit hook.
#   1. Block commits directly on protected branches (main).
#   2. Chain pre-commit framework (gitleaks staged, hygiene).
set -uo pipefail

PROTECTED="main master"
branch=$(git symbolic-ref --short HEAD 2>/dev/null || echo "")
for p in $PROTECTED; do
    if [ "$branch" = "$p" ]; then
        echo "🚫 Commit on '$branch' blocked. Main is release-only." >&2
        echo "" >&2
        echo "Work happens on 'dev' or a feature branch:" >&2
        echo "  git checkout dev && git pull" >&2
        echo "  git checkout -b feature/<slug>" >&2
        echo "" >&2
        echo "Bypass (emergency only):  git commit --no-verify" >&2
        exit 1
    fi
done

if command -v pre-commit &>/dev/null && [ -f .pre-commit-config.yaml ]; then
    pre-commit run --hook-stage pre-commit || exit 1
fi
exit 0
